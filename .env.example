# 复制本文件为 .env，再填入真实值：
#   copy .env.example .env
#
# docker compose 会读取本目录下的 .env，用来替换 yml 里的 ${...}

# ---------- 本地直接跑 uvicorn 时用 ----------
SQLALCHEMY_DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/blog

# ---------- docker compose 里 MySQL / 应用连接用 ----------
MYSQL_ROOT_PASSWORD=请改成你的密码
MYSQL_DATABASE=testdb

# Redis（本地）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_EXPIRE=60

# JWT
SECRET_KEY=请换成足够长的随机字符串

# 大模型
API_KEY=你的_API_Key
BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
